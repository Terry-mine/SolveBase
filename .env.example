# 复制成 .env 后按需修改。所有配置都可用环境变量覆盖（前缀 SOLVEBASE_）。

# 服务
SOLVEBASE_HOST=127.0.0.1
SOLVEBASE_PORT=8787
SOLVEBASE_DEBUG=false

# 数据目录（默认项目内 data/）
# SOLVEBASE_DATA_DIR=D:/Nothing/SolveBase/data
# SOLVEBASE_DATABASE_PATH=D:/Nothing/SolveBase/data/solvebase.db
# SOLVEBASE_ASSETS_DIR=D:/Nothing/SolveBase/data/assets

# 设备标识：多端同步时用于区分来源，每台机器改成不同的值
SOLVEBASE_DEVICE_ID=dev-local

# 外部能力。noop = 未启用（P0 默认）
# 接入方式见 README「如何加一个新 provider」
SOLVEBASE_LLM_PROVIDER=noop
SOLVEBASE_EMBEDDING_PROVIDER=noop
SOLVEBASE_RERANKER_PROVIDER=noop
SOLVEBASE_SYNC_PROVIDER=noop

# 前端开发服务器（P1 起会用到）
SOLVEBASE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
